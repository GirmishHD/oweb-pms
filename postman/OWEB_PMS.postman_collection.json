                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/users/me/",
              "host": ["{{base_url}}"],
              "path": ["auth", "users", "me", ""]
