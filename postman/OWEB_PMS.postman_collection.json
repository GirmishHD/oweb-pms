{
  "info": {
    "_postman_id": "oweb-pms-production-collection",
    "name": "OWEB Program Management System - Production API Suite",
    "description": "Comprehensive automated REST API test collection for OWEB PMS backend covering authentication, user management, programs, projects, procurement, contracts, inspections, tracking, master data, reports, and error boundaries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
